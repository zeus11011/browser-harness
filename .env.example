# LLM Model Configuration
# Provider is inferred automatically from model name (or set explicitly via LLM_PROVIDER)
# Examples: 'gemini-2.5-flash', 'google_genai:gemini-2.5-flash', 'claude-3-7-sonnet-20250219', 'gpt-4o',
#           'us.anthropic.claude-sonnet-4-5-20250929-v1:0' (AWS Bedrock, or 'bedrock_converse:<model-id>')
LLM_MODEL=gemini-3.5-flash
# LLM_PROVIDER=google_genai
# LLM_TEMPERATURE=0.7

# API Keys (Provider specific or generic fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_API_KEY=your_generic_api_key_here

# AWS Bedrock (LLM_PROVIDER=bedrock_converse, or a Bedrock model ID) uses the standard AWS credential chain
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
